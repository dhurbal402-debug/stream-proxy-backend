{
  "name": "stream-proxy",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "install:all": "npm install && npm --prefix client install",
    "dev": "concurrently -n api,web -c cyan,magenta \"node --watch server/index.js\" \"npm --prefix client run dev\"",
    "build": "npm --prefix client run build",
    "start": "node server/index.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "nodemon": "^3.1.14"
  }
}
